{
  "name": "mtg-crucible",
  "version": "0.3.11",
  "description": "TypeScript library for rendering custom Magic: The Gathering card images as PNGs",
  "repository": {
    "type": "git",
    "url": "https://github.com/domainellipticlanguage/mtg-crucible.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "default": "./dist/parser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "test": "vitest",
    "build": "rm -rf dist && tsc && tsc -p tsconfig.parser.json && tsc -p tsconfig.react.json",
    "build:parser": "tsc -p tsconfig.parser.json",
    "build:core": "tsc",
    "build:react": "tsc -p tsconfig.react.json",
    "dev": "npx tsx watch scripts/dev-server.ts",
    "spike": "npx tsx scripts/spike.ts",
    "generate-assets": "npx tsx logo/generate-assets.ts",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm login && npm version patch && npm publish && git push --follow-tags"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "card-renderer",
    "card-image",
    "custom-cards"
  ],
  "author": "domainellipticlanguage",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.92",
    "ipaddr.js": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sst": "^4.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
